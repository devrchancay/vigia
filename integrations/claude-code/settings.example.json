{
  "env": {
    "VIGIA_URL": "http://100.101.102.103:8787",
    "VIGIA_TOKEN": "paste-the-token-from-the-setup-screen"
  },
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "python3 ~/.claude/hooks/vigia_hook.py", "timeout": 5 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "python3 ~/.claude/hooks/vigia_hook.py", "timeout": 5 }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "python3 ~/.claude/hooks/vigia_hook.py", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "python3 ~/.claude/hooks/vigia_hook.py", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "python3 ~/.claude/hooks/vigia_hook.py", "timeout": 5 }] }]
  }
}
