{
  "schemaVersion": 1,
  "theme": { "mode": "dark", "palette": "ember", "background": "solid" },
  "grid": { "columns": 8, "rows": 4, "gap": 8 },
  "widgets": [
    { "id": "clock", "type": "clock", "pos": { "x": 0, "y": 0, "w": 5, "h": 2 } },
    { "id": "device", "type": "device", "pos": { "x": 5, "y": 0, "w": 3, "h": 2 },
      "params": { "show": ["battery", "batteryTemp", "memory", "wifi"] } },
    { "id": "welcome", "type": "note", "title": "Vigía", "pos": { "x": 0, "y": 2, "w": 8, "h": 2 },
      "params": { "text": "This is the default panel. Change it remotely with the vigia CLI, curl or your AI agent." } }
  ]
}
